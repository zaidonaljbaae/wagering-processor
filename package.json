{
  "name": "wagering-processor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "migrate": "bun src/infrastructure/persistence/migrate.ts up",
    "migrate:down": "bun src/infrastructure/persistence/migrate.ts down",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "infra:up": "docker compose up -d --wait postgres localstack",
    "infra:down": "docker compose down -v",
    "test": "bun test --timeout 180000",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration --timeout 60000",
    "test:concurrency": "bun test test/concurrency --timeout 180000",
    "test:all": "bun test --timeout 180000",
    "test:load": "bun scripts/load-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1156.0",
    "@mikro-orm/core": "6.6.17",
    "@mikro-orm/migrations": "6.6.17",
    "@mikro-orm/postgresql": "6.6.17",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "decimal.js": "10.6.0",
    "helmet": "8.3.0",
    "jose": "6.2.13",
    "pino": "9.14.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/express": "5.0.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "overrides": {
    "ajv": "8.20.0"
  }
}
