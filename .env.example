# Copy to .env to override docker-compose defaults. Never commit real secrets.
POSTGRES_USER=wagering
POSTGRES_PASSWORD=wagering-local
POSTGRES_DB=wagering
DATABASE_URL=postgresql://wagering:wagering-local@localhost:5432/wagering

AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

APP_ROLE=all
PORT=3000
METRICS_PORT=9464
LOG_LEVEL=info

# disabled | oidc
AUTH_MODE=disabled
# OIDC_ISSUER=http://localhost:8080/realms/wagering
# OIDC_AUDIENCE=wagering-api
# OIDC_JWKS_URI=http://localhost:8080/realms/wagering/protocol/openid-connect/certs
